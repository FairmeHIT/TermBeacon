    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/path/to/TermBeacon/scripts/termbeacon-hook.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/path/to/TermBeacon/scripts/termbeacon-hook.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/path/to/TermBeacon/scripts/termbeacon-hook.cjs\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/path/to/TermBeacon/scripts/termbeacon-hook.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/path/to/TermBeacon/scripts/termbeacon-hook.cjs\""
          }
